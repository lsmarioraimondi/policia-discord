# Token del bot (Developer Portal > Bot > Reset Token). NUNCA lo subas a Git.
DISCORD_TOKEN=

# ID de la aplicación (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID del servidor (Discord con modo desarrollador: clic derecho al servidor > Copiar ID)
GUILD_ID=

# ID del canal de texto donde se publican anuncios y votaciones
VOTING_CHANNEL_ID=

# Duración del permiso para hablar tras una votación aprobada (segundos)
SPEAK_DURATION_SECONDS=120

# Vigilancias = castigos temporales (segundos). La duración se duplica por cada castigo consecutivo
# a la MISMA persona (2 min, 4, 8, 16...) hasta el máximo; ver README.
BASE_PUNISHMENT_SECONDS=120
MAX_PUNISHMENT_SECONDS=86400

# Aislamiento (timeout nativo de Discord) tras 2 reconexiones durante un castigo
ISOLATION_DURATION_SECONDS=300

# Opcionales
# DATA_DIR=./data
# LOG_LEVEL=info
